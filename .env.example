# Copy to .env and fill in. docker compose reads .env automatically.

# The server's public IP (auto-detected if empty; set it to be sure).
SIPBX_PUBLIC_IP=203.0.113.10

# Hostname for the web UI (Traefik route) and the phone setup card.
# Point a DNS A record at the server.
SIPBX_DOMAIN=pbx.example.com

# SIP port phones register to. A non-standard port cuts scanner noise.
SIPBX_SIP_PORT=5060

# UDP ports for call audio (4 per call). Open them on the firewall.
SIPBX_RTP_PORTS=10000-10999

# Web UI listen address. 172.17.0.1 = host side of Docker's default bridge
# (for a reverse proxy container). 127.0.0.1:8080 for SSH tunnel access only.
SIPBX_HTTP_ADDR=172.17.0.1:8080

# SIP over TLS port (encrypted calls; open it on the firewall, TCP).
SIPBX_TLS_PORT=5061
# Certificate for TLS — either share Traefik's (see
# docker-compose.override.example.yml, which sets this path)...
#SIPBX_TLS_ACME_JSON=/traefik/acme.json
# ...or PEM files mounted into the container:
#SIPBX_TLS_CERT=/certs/fullchain.pem
#SIPBX_TLS_KEY=/certs/privkey.pem

# Never auto-ban these (comma-separated IPs/CIDRs), e.g. your office's public IP.
SIPBX_TRUSTED_NETS=

SIPBX_LOG_LEVEL=info
TZ=America/Los_Angeles
